# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(36))'
ATP_ADMIN_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ATP_IMAGE_MODEL=gpt-image-1.5
ATP_CHAT_MODEL=gpt-4.1-mini
ATP_DATA_DIR=./data
ATP_HISTORY_ENABLED=true
ATP_RETENTION_DAYS=7
ATP_WORKERS=2
ATP_MAX_PENDING=32
# Only set for a separate, trusted frontend origin. Same-origin needs no CORS.
ATP_CORS_ORIGINS=
